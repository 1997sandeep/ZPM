managed implementation in class ZBP_R_PMT_COMPLIANCE000 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_PMT_COMPLIANCE000 alias ZrPmtCompliance000
persistent table ZPMT_COMPLIANCE
extensible
draft table ZPMT_CMPLNC000_D
etag master Locallastchangedat
lock master total etag Lastchangedat
authorization master( global )
{
  field ( mandatory : create )
   Zequipment,
   Zcomptype;

  field ( readonly )
   Localcreatedby,
   Localcreatedat,
   Locallastchangedby,
   Locallastchangedat,
   Lastchangedat;

  field ( readonly : update )
   Zequipment,
   Zcomptype;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZPMT_COMPLIANCE corresponding extensible
  {
    Zequipment = ZEQUIPMENT;
    Zcomptype = ZCOMPTYPE;
    ZcomplianceNumber = ZCOMPLIANCE_NUMBER;
    Zplant = ZPLANT;
    Zreceipt = ZRECEIPT;
    Zstdate = ZSTDATE;
    Zexptype = ZEXPTYPE;
    Zenddate = ZENDDATE;
    Zcurrency = ZCURRENCY;
    Zamount = ZAMOUNT;
    Ztax = ZTAX;
    Ztotal = ZTOTAL;
    Zstate = ZSTATE;
    Zowner = ZOWNER;
    Zdms = ZDMS;
    Zfile = ZFILE;
    Zremark = ZREMARK;
    Zinstype = ZINSTYPE;
    Zinscompany = ZINSCOMPANY;
    Zpolicyno = ZPOLICYNO;
    Zidv = ZIDV;
    Zpolicytype = ZPOLICYTYPE;
    CreatedBy = createdby;
    CreatedAt = createdat;
    ChangedBy = changedby;
    ChangedAt = changedat;
    Createdon = createdon;
    Changedon = changedon;
    Zfilename = zfilename;
    Zmimetype = zmimetype;
    Localcreatedby = LOCALCREATEDBY;
    Localcreatedat = LOCALCREATEDAT;
    Locallastchangedby = LOCALLASTCHANGEDBY;
    Locallastchangedat = LOCALLASTCHANGEDAT;
    Lastchangedat = LASTCHANGEDAT;
  }

}