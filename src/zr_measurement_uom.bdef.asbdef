managed implementation in class ZBP_R_MEASUREMENT_UOM unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_MEASUREMENT_UOM alias ZrMeasurementUom
persistent table ZMEASUREMENT_UOM
extensible
draft table ZMSUREMENT_UOM_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   UOM,
   UomDes;

  field ( readonly )
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( readonly : update )
   UOM,
   UomDes;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZMEASUREMENT_UOM corresponding extensible
  {
    UOM = UOM;
    UomDes = UOM_DES;
    UomDimension = UOM_DIMENSION;
    LocalCreatedBy = LOCAL_CREATED_BY;
    LocalCreatedAt = LOCAL_CREATED_AT;
    LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedAt = LAST_CHANGED_AT;
  }

}