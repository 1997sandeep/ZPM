@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Utilization Per Equipment'
@Metadata.ignorePropagatedAnnotations: true
@ObjectModel.usageType:{
    serviceQuality: #X,
    sizeCategory: #S,
    dataClass: #MIXED
}
define view entity ZPM_UTIL_PER_EQUIP5
as select distinct from zsd_log_book_un   as a3
    left outer join     I_TechnicalObject as a1 on a3.equip_no = a1.Equipment
    left outer join     ZSD_LOGBOOK_UN as a2 on a3.equip_no = a2.Equipment
    
{
  key a3.key_field,
  key a3.func_desc           as Plant,
  key a3.equip_no            as Equipment,
//  key a1.YY1_RegisNo_IEQ     as serial_no,
  key a3.equip_desc       as EquipmentName,
  key a3.plant as plant12,                                                     
  key a1.TechnicalObjectType as Zobjtyp, 
      a3.dat  as Dat,
      '' as equip_status,
      a1.ManufacturerSerialNumber as YY1_ENGINEMAKE_IEQ,
      '' as YY1_REGISTRATIONNO_IEQ,
      a3.func_loc      as FunctionalLocation,
      a3.func_desc      as FunctionalDescription,
      a3.reg_no as RegistrationNo,
      a3.equip_obj   as EquipmentObject,
      a3.own_hire     as OwnHire,
      a3.wbs         as Wbs,
      a3.start_hr as StartHr, 
      a3.close_hr as CloseHr,
      a3.work_hr  as WorkHr,
      a3.idle_hr as IdleHr,
      a3.break_hr  as BreakHr,
      concat( concat( concat(right(a3.dat, 2), '/') , concat(substring(a3.dat,5,2), '/') ) , left(a3.dat, 4) ) as DatS,
a3.fuel_typ  as FuelType,
a3.fuel,
a3.fuelqty,
a3.start_km as StartKm,
a3.close_km as CloseKm,
a3.read_km as ReadKm,
a3.remarks as Remarks,
a3.meapt_km as Meaptkm,
a3.meapt_wh as Meaptwh,
'' as FiscYear,
'' as FiscMnth,
a3.shift,
a3.tot_plnt_prd as TotPlntPrd,
a3.machine_no as MachineNo,

cast(a3.start_hr as abap.dec( 15, 2 ))  as ChStrHmr,
cast(a3.start_km as abap.dec( 15, 2 ))  as ChStrKmr,
      ' '  as ChangeInd,
      '2'   as ChangeDays,
a3.cumm_hrs as CummulativeHrs,
a3.cumm_hrs_mp as CummulativeHrsMeasPt,
a3.cumm_km as CummulativeKm,
a3.cumm_km_mp as CummulativeKmMeasPt,
a3.flag,
a3.chass_no,
a3.fuel_consum,
a3.zodomet,
a3.ztotenghr,
a3.openingbal as OpeningBal,
a3.fuel_receipt as FuelReceipt,
a3.closingbal as ClosingBal,
a3.act_avg_kml as ActAvgKml,
a3.act_avg_lhr as ActAvgLhr,
a3.fuel_cash_purch as FuelCashPurch,
a3.fuel_theft as FuelTheft,
a3.owner_used_hmr as OwnerUsedHmr,
a3.owner_used_kmr as OwnerUsedKmr,
a3.fuel_used_owner as FuelUsedOwner,
a3.hmr_kmr as HmrKmr,
a3.wbs_elem_1 as WbsElem1,
a3.hmr_kmr_1 as HmrKmr1,
a3.wbs_elem_2 as WbsElem2,
a3.hmr_kmr_2 as HmrKmr2,
a3.wbs_elem_3 as WbsElem3,
a3.hmr_kmr_3 as HmrKmr3,
a3.wbs_elem_4 as WbsElem4,
a3.hmr_kmr_4 as HmrKmr4,
a3.breakdown_rsn as BreakDownRsn,
a2.LastLogEntry as LastLogEntry,
a3.uom,
//a1.YY1_ETMStartDate_IEQ as Startdate,
//a1.YY1_ETMEndDate_IEQ as Enddate,
a1.TechnicalObjectCategory as TechCategory,

a3.fuelqty as FuelConsumption


} group by 

 a3.key_field       ,
 a3.func_desc       ,
 a3.equip_no        ,
// a1.YY1_RegisNo_IEQ ,
 a3.equip_desc      ,
 a1.TechnicalObjectType, 
a3.dat,
a1.ManufacturerSerialNumber,
a3.func_loc ,
a3.func_desc,
a3.reg_no ,
a3.equip_obj,
a3.own_hire ,
a3.wbs      ,
a3.plant,
a3.start_hr ,
a3.close_hr ,
a3.work_hr,
a3.idle_hr,
a3.break_hr ,
a3.fuel_typ  ,
a3.fuel,
a3.fuelqty,
a3.start_km,
a3.close_km,
a3.read_km ,
a3.remarks, 
a3.meapt_km,
a3.meapt_wh,
a3.shift,
a3.tot_plnt_prd, 
a3.machine_no,
a3.start_hr,
a3.cumm_hrs,
a3.cumm_hrs_mp, 
a3.cumm_km ,
a3.cumm_km_mp, 
a3.flag,
a3.chass_no,
a3.fuel_consum,
a3.zodomet,
a3.ztotenghr,
a3.openingbal  ,
a3.fuel_receipt,
a3.closingbal  ,
a3.act_avg_kml ,
a3.act_avg_lhr ,
a3.fuel_cash_purch ,
a3.fuel_theft      ,
a3.owner_used_hmr ,
a3.owner_used_kmr ,
a3.fuel_used_owner ,
a3.hmr_kmr    ,
a3.wbs_elem_1 ,
a3.hmr_kmr_1  ,
a3.wbs_elem_2 ,
a3.hmr_kmr_2  ,
a3.wbs_elem_3 ,
a3.hmr_kmr_3  ,
a3.wbs_elem_4 ,
a3.hmr_kmr_4  ,
a3.breakdown_rsn,
a2.LastLogEntry,
a3.uom,
//a1.YY1_ETMStartDate_IEQ,
//a1.YY1_ETMEndDate_IEQ,
a1.TechnicalObjectCategory ,
a3.fuelqty
